const snippetPlain = `// ── SimulationRecorder ────────────────────────────────────────────────────────
// Runs physics in script mode to record a force-based dice throw frame by frame.
public void StartRecording(Vector3 force, Vector3 torque)
{
    Physics.simulationMode = SimulationMode.Script;

    recordingData.rb.AddForce(force, ForceMode.Impulse);
    recordingData.rb.AddTorque(torque, ForceMode.Impulse);

    do // simulate one frame first so forces are applied before checking velocity
    {
        recordingData.recordedAnimation.Add(
            new RecordedFrame(transform.position, transform.rotation));
        Physics.Simulate(Time.fixedDeltaTime);
    }
    while (recordingData.rb.velocity.magnitude > 0.01f
        && recordingData.rb.angularVelocity.magnitude > 0.01f);

    finalUp = GetComponent<Dice>().CalculateNewUp(); // store the face that landed up
    Physics.simulationMode = SimulationMode.FixedUpdate;
}

// ── Dice.cs ───────────────────────────────────────────────────────────────────
// Dot-product face detection: highest dot against Vector3.up = face currently up.
public int CalculateNewUp()
{
    PopulateDictionary();
    float maxDot = -1; int upFace = 0;
    foreach (var pair in faceDirections)
    {
        float dot = Vector3.Dot(Vector3.up, pair.Key);
        if (dot > maxDot) { maxDot = dot; upFace = pair.Value; }
    }
    return upFace;
}
`;

