---
import BaseLayout from "../../layouts/BaseLayout.astro";
import UnderConstruction from "../../components/layout/UnderConstruction.astro";
import ProjectFooter from "../../components/layout/ProjectFooter.astro";
---

<BaseLayout title="Connect4Dead - Jonathan To">
  <div slot="breadcrumb" class="breadcrumb-bar">
    <a href="/personal-projects/">PersonalProjects()</a>
    <span class="breadcrumb-sep">/</span>
    <span class="breadcrumb-current">Connect4Dead</span>
  </div>

  <UnderConstruction
    projectName="Connect4Dead"
    backHref="/personal-projects/"
    backLabel="PersonalProjects()"
  />

  <ProjectFooter
    prev={{ label: "Deterministic Dice", href: "../deterministic-dice/" }}
    next={{ label: "Whatever Floats Your Goat", href: "../whatever-floats-your-goat/" }}
    author="Jonathan To · Gameplay Programmer & Game Designer"
    year={2026}
  />
</BaseLayout>
