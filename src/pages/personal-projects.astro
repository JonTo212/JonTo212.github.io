---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import FilterBar from "../components/layout/FilterBar.astro";
import ProjectCard from "../components/layout/ProjectCard.astro";

const filters = ["All", "Programming", "Design", "Game Jam", "WIP", "Team"];

const projects = [
  {
    title: "Ronin Run",
    href: "../projects/ronin-run/",
    imgSrc: "/cover-images/roninrun_hero.png",
    desc: "Source-inspired movement system with CS-style strafing and shurikens that each carry their own movement and traversal mechanics.",
    isWip: true,
    tags: [
      { label: "Programming", type: "programming" },
      { label: "Design", type: "design" },
      { label: "WIP", type: "wip" },
    ],
    meta: [
      { label: "status", value: "ongoing" },
      { label: "team", value: "solo" },
    ],
  },
  {
    title: "Procedural 2D Map Generator",
    href: "../projects/wfc-generator/",
    imgSrc: "/cover-images/wfc_hero.png",
    desc: "Wave function collapse-based procedural 2D map generator with integrated pathfinding via BFS and DFS.",
    isWip: false,
    tags: [{ label: "Programming", type: "programming" }],
    meta: [
      { label: "status", value: "complete" },
      { label: "team", value: "solo" },
    ],
  },
  {
    title: "Deterministic Dice",
    href: "../projects/deterministic-dice/",
    imgSrc: "/cover-images/deterministic-dice_hero.png",
    desc: "Rigged physics-based dice roll that guarantees a target face - uses a recording and resimulation system to lock in the result.",
    isWip: false,
    tags: [{ label: "Programming", type: "programming" }],
    meta: [
      { label: "status", value: "complete" },
      { label: "team", value: "solo" },
    ],
  },
];

const jamProjects = [
  {
    title: "Connect4Dead",
    href: "../projects/connect4dead/",
    imgSrc: "/cover-images/connect4dead_hero.png",
    desc: "Combining the two themes of 'that shouldn't be there' and 'what just happened?' for ToJam 2026 - Connect 4, but with guns. Players take turns shooting their chips into place, each with their own unique behaviours.",
    isWip: false,
    tags: [
      { label: "Programming", type: "programming" },
      { label: "Design", type: "design" },
      { label: "Game Jam", type: "game-jam" },
    ],
    meta: [
      { label: "status", value: "complete" },
      { label: "team", value: "6" },
    ],
  },
  {
    title: "Whatever Floats Your Goat",
    href: "../projects/whatever-floats-your-goat/",
    imgSrc: "/cover-images/whatever-floats-your-goat_hero.png",
    desc: "A silly little fishing endless runner made over the course of 3 days for TOJam 2025, under the theme 'the more you have, the worse it is.' Players must gather as much loot as possible while balancing the weight of each side of their boat.",
    isWip: false,
    tags: [
      { label: "Programming", type: "programming" },
      { label: "Design", type: "design" },
      { label: "Game Jam", type: "game-jam" },
    ],
    meta: [
      { label: "status", value: "complete" },
      { label: "team", value: "6" },
    ],
  },
  {
    title: "Knight and the Mad King",
    href: "../projects/knight-and-the-mad-king/",
    imgSrc: "/cover-images/knight-and-the-mad-king_hero2.png",
    desc: "An interactive fiction where players drag and drop characters and objects to fix the errors on a children's fantasy book, developed over the course of 5 days during Sheridan College's 2025 Winter Design Week.",
    isWip: false,
    tags: [
      { label: "Programming", type: "programming" },
      { label: "Design", type: "design" },
      { label: "Game Jam", type: "game-jam" },
    ],
    meta: [
      { label: "status", value: "complete" },
      { label: "team", value: "5" },
    ],
  },
  {
    title: "Sky High Scrubbing",
    href: "../projects/sky-high-scrubbing/",
    imgSrc: "/cover-images/skyhighscrubbing_hero.png",
    desc: "Arcade cabinet microgame for Sheridan College's Design Week 2023, shipped in a week. P1 scrubs omnidirectionally, P2 moves the scaffolding and sprays water - one minute on the clock.",
    isWip: false,
    tags: [
      { label: "Design", type: "design" },
      { label: "Game Jam", type: "game-jam" },
    ],
    meta: [
      { label: "status", value: "complete" },
      { label: "team", value: "5" },
    ],
  },
];
---

<BaseLayout title="Personal Projects - Jonathan To">
  <div class="flex flex-col gap-8">
    <PageHeader
      comment="// ============================================================<br/>//   personal_projects[] - tinkering, experiments, WIPs<br/>// ============================================================"
      title="PersonalProjects()"
      subtitle="Personal experiments, works-in-progress, game jams, and non-game pieces - things driven by interest and passion, not requirements."
      subtitleColor="white"
      accentColor="yellow"
    />

    <FilterBar filters={filters} accentColor="yellow" />

    <section>
      <div
        class="mb-4 flex items-center gap-2 font-mono text-[0.9rem] text-[#4a7a4a]"
      >
        <div class="h-1.5 w-1.5 rounded-full bg-[#c8b97e] opacity-50"></div>
        // projects[]
        <span class="count ml-auto text-[11px] text-[#555555]"
          >// {projects.length} entries</span
        >
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          projects.map((project) => (
            <ProjectCard
              href={project.href}
              imgSrc={project.imgSrc}
              title={project.title}
              desc={project.desc}
              tags={project.tags as any}
              meta={project.meta}
              isWip={project.isWip}
            />
          ))
        }
      </div>
    </section>

    <section>
      <div
        class="mb-4 flex items-center gap-2 font-mono text-[0.9rem] text-[#4a7a4a]"
      >
        <div class="h-1.5 w-1.5 rounded-full bg-[#c8b97e] opacity-50"></div>
        // game_jams[]
        <span class="jam-count ml-auto text-[11px] text-[#555555]"
          >// {jamProjects.length} entries</span
        >
      </div>

      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {
          jamProjects.map((project) => (
            <ProjectCard
              href={project.href}
              imgSrc={project.imgSrc}
              title={project.title}
              desc={project.desc}
              tags={project.tags as any}
              meta={project.meta}
              isWip={project.isWip}
            />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
